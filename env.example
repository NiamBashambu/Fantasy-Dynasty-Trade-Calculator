# Copy to .env and fill in, or export these in your shell / hosting dashboard.
# There is no database; nothing here points at one.

# development | production
APP_ENV=development

# Required when APP_ENV=production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. Without it the app still works; explanations use built-in text.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional tuning
# LLM_CALLS_PER_HOUR=20
# REQUESTS_PER_MINUTE=60
# VALUES_CACHE_SECONDS=21600
# LEAGUE_CACHE_SECONDS=300
# CACHE_DIR=.cache
# TRUST_PROXY=1
